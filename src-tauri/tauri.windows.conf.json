{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "BrowseFork",
        "url": "index.html?view=chooser",
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "width": 340,
        "height": 220,
        "minWidth": 300,
        "minHeight": 200,
        "resizable": false,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
